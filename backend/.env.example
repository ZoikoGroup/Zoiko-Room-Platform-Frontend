DATABASE_URL=postgresql+psycopg://zoiko:zoiko@localhost:5432/zoiko_rooms
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
# Leave blank for host-only cookies (needed when frontend/backend are on different
# domains, e.g. Vercel + Render). Set to ".zoikorooms.com" once both share that domain.
COOKIE_DOMAIN=

SEED_ADMIN_EMAIL=admin@zoikorooms.com
SEED_ADMIN_PASSWORD=change-this-password

# Base URL this backend is reachable at -- used to build absolute URLs for uploaded images.
PUBLIC_API_URL=http://localhost:8000
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=8

# USER identity documents are stored here, never under UPLOAD_DIR -- this directory
# is never mounted as a static route.
IDENTITY_UPLOAD_DIR=secure_uploads/identity
IDENTITY_DOCUMENT_MAX_SIZE_MB=10

# Used to build the link inside password-reset emails.
FRONTEND_URL=http://localhost:3000
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# Chat assistant (Admin and USER). Without a real key, the assistant replies
# with a configuration error instead of failing to start.
LLM_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-120b

# Email. "file" (default) writes emails to backend/dev_mail_outbox/ instead of
# sending them -- safe everywhere until explicitly overridden. Set to "smtp" in
# production and fill in the SMTP_* values below (works with SES, SendGrid,
# Resend, or any standard SMTP relay's SMTP interface).
EMAIL_PROVIDER=file
EMAIL_FROM=Zoiko Rooms <no-reply@zoikorooms.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
